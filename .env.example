# ---- Telegram Bot API ----
# Token from @BotFather (Bot settings -> API Token).
TELEGRAM_BOT_TOKEN=123456:replace-me
# Secret you choose; Telegram echoes it in X-Telegram-Bot-Api-Secret-Token. Leave blank only for
# local dev (blank accepts every request).
TELEGRAM_WEBHOOK_SECRET=
# "webhook" (production) or "polling" (local dev - needs no public URL).
TELEGRAM_MODE=webhook
# Bot username WITHOUT the leading @ (from @BotFather). Used for t.me share/deep links.
BOT_USERNAME=everydaynepal_bot
# Public HTTPS base URL of this service (no trailing slash). Webhook: {base}/telegram/webhook
PUBLIC_BASE_URL=https://your-tunnel.example.com
# Display name used in profiles and share text.
BOT_SENDER_NAME=Everyday Nepal
# Long-poll timeout (seconds) when TELEGRAM_MODE=polling.
TELEGRAM_POLL_TIMEOUT=30
# Drop updates queued while the bot was offline when (re)registering.
TELEGRAM_DROP_PENDING_UPDATES=true
# Publish commands/descriptions and (un)set the webhook at startup.
TELEGRAM_SETUP_ON_STARTUP=true

# ---- Database ----
# Local dev default is SQLite. Production: postgresql+asyncpg://user:pass@postgres:5432/everyday_nepal
DATABASE_URL=sqlite+aiosqlite:///./everyday_nepal.db
AUTO_CREATE_TABLES=true

# ---- App ----
ENVIRONMENT=development
LOG_LEVEL=INFO
SCHEDULER_ENABLED=true
REFRESH_ON_STARTUP=true
RATE_LIMIT_PER_MINUTE=20
GROUP_RATE_LIMIT_PER_MINUTE=6
UNSUPPORTED_REPLY_COOLDOWN_SECONDS=60
DEDUPE_TTL_HOURS=24
HTTP_TIMEOUT_SECONDS=10
MAX_TEXT_LENGTH=4096
USER_DATA_RETENTION_DAYS=30
WELCOME_AFTER_SILENCE_DAYS=30
ANALYTICS_SALT=change-this-salt
# Numeric Telegram id(s) allowed to use /stats (get them from @userinfobot).
# Comma-separated lists are allowed, e.g. 111111111,222222222.
ADMIN_TELEGRAM_ID=
# Daily analytics summary DM to the admin at 21:00 NPT (needs ADMIN_TELEGRAM_ID).
FEATURE_ADMIN_DAILY_SUMMARY=false
# Analytics rows older than this many days are deleted nightly.
EVENTS_RETENTION_DAYS=180

# Daily briefing at 07:00 NPT for active users; /unsubscribe opts out.
FEATURE_DAILY_DIGEST=true
DIGEST_TIME_NPT=07:00
DIGEST_RATE_PER_SECOND=20

# Scheduled source refresh times (Nepal Time).
REFRESH_VEGETABLES_HOUR_NPT=5
REFRESH_VEGETABLES_MINUTE_NPT=30
REFRESH_FUEL_HOUR_NPT=6
REFRESH_FUEL_MINUTE_NPT=0
REFRESH_METALS_HOUR_NPT=10
REFRESH_METALS_MINUTE_NPT=30
REFRESH_FOREX_HOUR_NPT=11
REFRESH_FOREX_MINUTE_NPT=15
REFRESH_NEWS_HOURS=2
REFRESH_WEATHER_SECONDS=1800
HOROSCOPE_HOUR_NPT=5
